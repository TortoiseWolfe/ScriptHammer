scripts/__tests__/fixtures/*
!scripts/__tests__/fixtures/README.md

# SpecKit wrapper (Docker-first) — tool + cache state, never commit
.speckit-tools/
.speckit-cache/
.lighthouseci/

# Digital twins (#232): PRIVATE BY DEFAULT. Baked sites and their configs are
# client-address material — nothing under sites/ or public/twins/ is committed
# unless explicitly allowlisted below (the flagship demo is). To publish a new
# site, add its own `!` entries deliberately.
# `*.local.json` (anywhere) is the local-demo side channel (#234): HUD links
# to private property pages live in twins/<slug>/links.local.json and must
# NEVER be committable, even inside an allowlisted twin.
*.local.json
/sites/*
!/sites/chatt.json
# #234 consent decision (2026-07-10): the as-built capture is published as an
# anonymized portfolio piece (street-visible scrub bar) — deliberately
# allowlisted, same pattern as chatt.
!/sites/east-main-street-chattanooga.json
/public/twins/*
!/public/twins/chatt/
!/public/twins/east-main-street-chattanooga/
# Every site's raw upstream cache is large and local-only (regenerable via
# `pnpm bake`) — the wildcard also covers any future allowlisted site.
/public/twins/*/_raw/
/public/twins/*/_tmp/
# As-built captures (#234) are client property data — ignored even inside an
# allowlisted twin. Publishing a consented capture requires its own deliberate
# `!` entry, same as publishing the twin itself.
/public/twins/*/house/
# Published per the 2026-07-10 consent decision (anonymized portfolio piece):
!/public/twins/east-main-street-chattanooga/house/
# Warehouse-derived building models (#259) are 3D Warehouse General Model
# License content — local-only by default; publishing is a deliberate
# per-site call, same pattern as house/.
/public/twins/*/models/
# Published 2026-07-10 (owner decision): chatt's sampled city ships — the
# GLBs are heavily transformative abstractions (154:1, textures replaced by
# sampled flat colors) and the in-viewer Directory credits every creator
# with a link back to the Warehouse source page.
!/public/twins/chatt/models/
# Dir re-include + contents re-include is the robust pair: without the `**`
# line, files under the dir can still match the ignore rule on some git
# versions (models.json was tracked-but-ignore-matching until iter 5).
!/public/twins/chatt/models/**
knowledge/spatial


# graphify: local and regenerable — rebuild with /graphify-init or `graphify update .`
# NOT committed: the post-commit hook rewrites graph.json on every commit and it
# delta-compresses poorly, so committing it would grow the repo forever.
graphify-out/

# Stray downloads that land in the repo root (#275). These were sitting in the
# build context and keeping `git status` permanently noisy. *:Zone.Identifier is
# the WSL alternate-data-stream marker Windows attaches to downloaded files.
*.skp
*:Zone.Identifier

# Editor and script backups (#424). Anything a tool leaves beside the file it
# edited is untracked-but-not-ignored, so one `git add -A` commits it. That is
# the same shape as #392, where a local root build rewrote public/manifest.json
# and the only mitigation was remembering not to stage everything. This is the
# version that does not depend on remembering.
*.bak
*.bak-*
*.orig
*.rej
*~
*.swp

# Local visual-verification scratch (#432) — session tokens live here.
.pay-verify/

# Stray tool output and screenshots that land in the repo root (#523)
# Same rationale as #424: anything a tool leaves beside the file it edited is
# untracked-but-not-ignored, so one `git add -A` commits it. The blog-images rule
# matters most - public/ ships to the static export.
.tmp-*
/Screenshot *.png
/public/blog-images/**/Screenshot *.png

# The rules above only catch files that happen to be NAMED `.tmp-*` or
# `Screenshot *`. Working files arrive with arbitrary names — client photos,
# estimates, exported diagrams — and four were sitting untracked at the root
# when this was written. The repo tracks NO image, html or svg at its root
# (`git ls-files | grep -v /` is markdown, config and lockfiles only), so
# anchoring by extension is safe and does not depend on guessing a name.
# Anything genuinely belonging to the project lives in `public/` or `docs/`.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.html
/*.svg

# Emitted by next.config.ts for scripts/check-first-load-budget.mjs (#636).
# Production builds only; lives at the repo root because that is what crosses
# the builder/dev container boundary (#293).
.chunk-modules.json
.commitmsg.tmp

# Written by the zero-assertion reporter (#861); a per-run CI verdict, never committed.
zero-assertions.json

# Talk decks: the HTML is the source and is tracked; the PDF is a build output
# rendered by scripts/render-talk.mjs (#516-adjacent, same rule as public/*).
docs/talks/*.pdf
